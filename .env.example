# GovMithra AI — Environment Variables

# Database (SQLite for development)
DATABASE_URL=file:./db/govmithra.db

# GLM-5.2 AI (z-ai-web-dev-sdk reads this automatically)
# Set ZAI_API_KEY in your environment before running the app.
# ZAI_API_KEY=your_api_key_here

# ──────────────────────────────────────────────
# MOBILE / ANDROID (Capacitor) CONFIGURATION
# ──────────────────────────────────────────────
# When building the Android app, set this to your computer's local IP address
# so the phone can reach the dev server over WiFi.
# Find your IP: `ifconfig` (Mac/Linux) or `ipconfig` (Windows)
# Example: http://192.168.1.10:3000/api
#
# This is read at BUILD TIME and baked into the Android app.
# Users can also override it at RUNTIME via Settings > Server Configuration.
#
# NEXT_PUBLIC_API_BASE=http://192.168.1.10:3000/api
